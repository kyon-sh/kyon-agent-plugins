{
  "description": "Report Codex's status to Kyon",
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "sh \"$PLUGIN_ROOT/hooks/report.sh\" session_start", "timeout": 5 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "sh \"$PLUGIN_ROOT/hooks/report.sh\" prompt_submit", "timeout": 5 }] }
    ],
    "PermissionRequest": [
      { "hooks": [{ "type": "command", "command": "sh \"$PLUGIN_ROOT/hooks/report.sh\" permission_request", "timeout": 5 }] }
    ],
    "PostToolUse": [
      { "hooks": [{ "type": "command", "command": "sh \"$PLUGIN_ROOT/hooks/report.sh\" tool_complete", "timeout": 5 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "sh \"$PLUGIN_ROOT/hooks/report.sh\" stop", "timeout": 5 }] }
    ],
    "Interrupt": [
      { "hooks": [{ "type": "command", "command": "sh \"$PLUGIN_ROOT/hooks/report.sh\" idle_prompt", "timeout": 5 }] }
    ]
  }
}
